# Copy to .env (local) or add in Netlify > Site settings > Environment variables.

# Supabase (Project settings > API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT
SUPABASE_PROJECT_ID=YOUR-PROJECT
# SERVER ONLY. Never prefix with VITE_. Needed for uploads, covers, publishing.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Trace AI: any OpenAI-compatible chat endpoint (OpenAI, OpenRouter, Gemini compat, etc.)
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemini-2.5-flash
# Legacy Lovable gateway key (used only if AI_API_KEY is empty)
LOVABLE_API_KEY=
