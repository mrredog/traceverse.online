# Trace AI: any OpenAI-compatible chat endpoint (OpenAI, OpenRouter, Gemini compat, etc.)
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemini-2.5-flash
# Legacy Lovable gateway key (used only if AI_API_KEY is empty)
LOVABLE_API_KEY=

# AI cover generation (OpenAI-compatible images API). Chat uses AI_BASE_URL above;
# images default to OpenAI's endpoint unless you set AI_IMAGE_BASE_URL.
AI_IMAGE_BASE_URL=https://api.openai.com/v1
AI_IMAGE_MODEL=gpt-image-1
